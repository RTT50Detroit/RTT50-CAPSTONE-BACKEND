<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Jonte Grasty" />
    <title>The Social Match Game: Meet The Community</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/cardStyles.css">
</head>
<body>
<header class="site-header">
    <a class="brand" href="/" aria-label="Social Match home">
        <span class="brand-mark">S</span>
        <span>Social Match</span>
    </a>
    <span class="header-status"><span class="status-dot"></span>Find your people</span>
</header>

<main class="page-shell">
    <section class="page-intro">
        <p class="eyebrow">The community</p>
        <h1>Meet the people<br><em>worth knowing.</em></h1>
        <p class="intro-copy">Browse the latest members and discover your next meaningful connection.</p>
        <div class="member-count"><strong><%= registrants.length %></strong> <span>members and counting</span></div>
    </section>

    <section class="filter-panel" aria-label="Member filters">
        <form method="GET" class="filter-form">
            <label>
                <span>Sex</span>
                <select name="gender">
                    <option value="">All</option>
                    <option value="male" <%= filters && filters.gender === 'male' ? 'selected' : '' %>>Male</option>
                    <option value="female" <%= filters && filters.gender === 'female' ? 'selected' : '' %>>Female</option>
                </select>
            </label>
            <label>
                <span>Min age</span>
                <input type="number" name="minAge" min="18" max="100" value="<%= filters && filters.minAge ? filters.minAge : '' %>" placeholder="18" />
            </label>
            <label>
                <span>Max age</span>
                <input type="number" name="maxAge" min="18" max="100" value="<%= filters && filters.maxAge ? filters.maxAge : '' %>" placeholder="60" />
            </label>
            <button type="submit">Apply filters</button>
            <a href="/" class="clear-filter">Clear</a>
        </form>
    </section>

    <section class="profile-container" aria-label="Member profiles">
        <% if (registrants.length) { %>
            <% registrants.forEach(registrant => { %>
                <article class="profile-card">
                    <div class="profile-image-wrap">
                        <img src="<%= registrant.photo || (registrant.gender && registrant.gender.toLowerCase().startsWith('male') ? '/images/male.png' : '/images/female.png') %>" alt="<%= registrant.name || 'Member' %>'s profile picture" />
                        <span class="profile-badge">New member</span>
                    </div>
                    <div class="profile-content">
                        <h2><%= registrant.name || 'Unknown Name' %></h2>
                        <div class="profile-details">
                            <span><b>Age</b><%= registrant.age || 'N/A' %></span>
                            <span><b>Gender</b><%= registrant.gender || 'N/A' %></span>
                        </div>
                        <p class="joined-date">Joined <%= registrant.createdAt ? new Date(registrant.createdAt).toLocaleDateString(undefined, { month: 'short', year: 'numeric' }) : 'recently' %></p>
                    </div>
                </article>
            <% }); %>
        <% } else { %>
            <div class="empty-state">
                <span class="empty-icon">+</span>
                <h2>Your community starts here.</h2>
                <p>No members have joined yet.</p>
            </div>
        <% } %>
    </section>
</main>
</body>
</html>